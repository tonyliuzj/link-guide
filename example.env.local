# LinkGuide Environment Configuration

# Session secret for NextAuth (generate a random string)
SESSION_PASSWORD=your-random-session-secret-here

# Trust the host header behind reverse proxies and custom domains
AUTH_TRUST_HOST=true

# Database location (default: ./data/linkguide.db)
DATABASE_URL=./data/linkguide.db

# Server port (default: 3000)
PORT=3000

# Optional: SMTP settings enable "Forgot password" emails
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# Defaults to true on port 465, false otherwise
# SMTP_SECURE=false
# SMTP_FROM="LinkGuide <no-reply@example.com>"
# Public URL used in reset links (defaults to the site domain from settings)
# APP_URL=https://example.com
